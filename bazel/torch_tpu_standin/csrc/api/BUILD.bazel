load("@nanobind_bazel//:build_defs.bzl", "nanobind_extension")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# tensor_buffer.h is torch_tpu's public tensor-buffer API header, copied from
# torch_tpu commit 197b9a6858a6e4f5a3a746059803e24a7125739e (csrc/api/). The
# torch extension compiles against it and binds the symbols at import to the
# installed torch_tpu wheel, which exports them from its per-torch-version
# common library.
cc_library(
    name = "tensor_buffer",
    hdrs = ["tensor_buffer.h"],
    deps = [
        "//shims/torch:aten_headers",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/types:span",
        "@xla//xla/pjrt:pjrt_client",
    ],
)
