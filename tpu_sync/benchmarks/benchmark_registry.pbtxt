benchmarks {
  name: "h2d_d2h_gating_jax"
  description: "JAX perf gate: stable configs, fail if median Gbps drops below the statistical floor in h2d_d2h_gating_jax_baselines.json"
  owner: "raiden-dev"

  workload {
    action: "./ml_actions/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//tpu_sync/benchmarks:h2d_d2h_benchmark_gating" }
    action_inputs { key: "runtime_flags" value: "--framework=jax" }
  }

  environment_configs {
    id: "tpu-v5e-single-node"
    runner_label: "linux-x86-ct5lp-224-8tpu"
    container_image: "us-central1-docker.pkg.dev/tpu-prod-env-multipod/tpu-raiden/ml-build:gcc12-headers-ibverbs"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=oss --config=ci" }
  }

  metrics { name: "jax_int32_L1_8x128x1024x128/d2h_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "jax_int32_L1_8x128x1024x128/h2d_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "jax_float32_L1_8x128x1024x128/d2h_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "jax_float32_L1_8x128x1024x128/h2d_gbps" unit: "Gbps" stats { stat: MEAN } }

  # Legacy un-prefixed aliases for MLCompass monitoring (go/tpu-sync-oss-mlcompass)
  metrics { name: "int32_L1_8x128x1024x128/d2h_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "int32_L1_8x128x1024x128/h2d_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "float32_L1_8x128x1024x128/d2h_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "float32_L1_8x128x1024x128/h2d_gbps" unit: "Gbps" stats { stat: MEAN } }
}

benchmarks {
  name: "h2d_d2h_gating_torch"
  description: "PyTorch perf gate: the h2d_d2h_gating_jax configs on the torch path, fail if median Gbps drops below the statistical floor in h2d_d2h_gating_torch_baselines.json"
  owner: "raiden-dev"

  # The same gate as h2d_d2h_gating_jax, run through ci/run_in_torch_env.py
  # rather than bazel: the torch extension has to be built with build.sh against
  # the installed torch and torch_tpu wheels, which that script does first.
  # python_version is the Python build.sh compiles the extension for.
  # project_path has no dependency files, so BAP installs nothing itself.
  workload {
    action: "./ml_actions/actions/workload_executors/python"
    action_inputs { key: "python_version" value: "3.12" }
    action_inputs { key: "script_path" value: "ci/run_in_torch_env.py" }
    action_inputs { key: "project_path" value: "ci" }
    action_inputs { key: "runtime_flags" value: "tpu_sync/benchmarks/h2d_d2h_benchmark_gating.py --framework=torch" }
  }

  environment_configs {
    id: "tpu-v5e-single-node"
    runner_label: "linux-x86-ct5lp-224-8tpu"
    container_image: "us-central1-docker.pkg.dev/tpu-prod-env-multipod/tpu-raiden/ml-build:gcc12-headers-ibverbs"
  }

  metrics { name: "torch_int32_L1_8x128x1024x128/d2h_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "torch_int32_L1_8x128x1024x128/h2d_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "torch_float32_L1_8x128x1024x128/d2h_gbps" unit: "Gbps" stats { stat: MEAN } }
  metrics { name: "torch_float32_L1_8x128x1024x128/h2d_gbps" unit: "Gbps" stats { stat: MEAN } }
}

benchmarks {
  name: "h2h_cpp_gate"
  description: "C++ H2H perf+integrity gate: a thin Python driver spawns the C++ h2h_benchmark_runner (NO JAX bindings), fails if the receiver's byte-integrity check fails."
  owner: "raiden-dev"

  workload {
    action: "./ml_actions/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//tpu_sync/benchmarks:h2h_cpp_gate" }
    action_inputs { key: "runtime_flags" value: "--iters=5" }
  }

  environment_configs {
    id: "tpu-v5e-single-node"
    runner_label: "linux-x86-n2-32"
    container_image: "us-central1-docker.pkg.dev/tpu-prod-env-multipod/tpu-raiden/ml-build:gcc12-headers-ibverbs"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=oss --config=ci" }
  }

  metrics { name: "1048576B_x64_P1/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
  metrics { name: "1048576B_x64_P8/cpp_gbs" unit: "GB/s" stats { stat: MEAN } }
}
