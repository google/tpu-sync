# Peers come from TPU_WORKER_HOSTNAMES; sender and receiver sync purely over TCP
# (READY / VERDICTS on --peer_port). runtime_flags: --data_interface=eth0 pins the data
# plane (runner auto-discovery includes eth0 and IPv6-only NICs, so record and gate could
# otherwise measure different NIC sets). bazel_run_flags: no MODULE.bazel.lock /
# bazel-* symlink writes into user_repo.
benchmarks {
  name: "h2h_multihost_gate"
  description: "Cross-host H2H gate over the real NIC on the correctness suite (1048576B_x64_P1, 1048576B_x64_P8, 1048573B_x64_P4). Fails on DATA CORRUPTION (receiver byte check), NO MEASUREMENT, NO VERDICT, or median GB/s below the floor recorded in h2h_multihost_baselines.json; configs without a recorded floor print NO FLOOR and gate on byte-integrity only."
  owner: "raiden-dev"

  workload {
    action: "./ml_actions/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//tpu_sync/benchmarks:h2h_multihost_bench" }
    action_inputs { key: "runtime_flags" value: "--data_interface=eth0 --stage=gate --suite=correctness --iters=50" }
  }

  environment_configs {
    id: "tpu-v5e-multi-node"
    runner_label: "linux-x86-ct5lp-4tpu-x4"
    container_image: "us-central1-docker.pkg.dev/tpu-prod-env-multipod/tpu-raiden/ml-build:gcc12-headers"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=oss --config=ci --lockfile_mode=off --experimental_convenience_symlinks=ignore" }
  }

  # In gate stage the driver emits one scalar per label (the median), so only MEDIAN is
  # tracked. P1 carries a BAP static threshold mirroring h2h_multihost_baselines.json
  # (baseline 1.353, max_margin 0.10 -> fails below 1.2177 GB/s); P8/P4 are
  # informational (integrity-only in the driver, NO FLOOR).
  metrics { name: "1048576B_x64_P1/cpp_gbs" unit: "GB/s" stats { stat: MEDIAN comparison { baseline { value: 1.353 } threshold { value: 0.10 } improvement_direction: GREATER } } }
  metrics { name: "1048576B_x64_P8/cpp_gbs" unit: "GB/s" stats { stat: MEDIAN } }
  metrics { name: "1048573B_x64_P4/cpp_gbs" unit: "GB/s" stats { stat: MEDIAN } }
}
