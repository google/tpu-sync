benchmarks {
  name: "h2d_d2h_record_jax"
  description: "Re-measure and emit h2d_d2h_gating_jax_baselines.json as a workload artifact."
  owner: "raiden-dev"
  workload {
    action: "./ml_actions/actions/workload_executors/bazel"
    action_inputs { key: "target" value: "//tpu_sync/benchmarks:h2d_d2h_benchmark_gating" }
    action_inputs { key: "runtime_flags" value: "--record --iters=500 --framework=jax" }
  }
  environment_configs {
    id: "tpu-v5e-single-node"
    runner_label: "linux-x86-ct5lp-224-8tpu"
    container_image: "us-central1-docker.pkg.dev/tpu-prod-env-multipod/tpu-raiden/ml-build:gcc12-headers-ibverbs"
    workload_action_inputs { key: "bazel_run_flags" value: "-c opt --config=oss --config=ci" }
  }
}

benchmarks {
  name: "h2d_d2h_record_torch"
  description: "Re-measure and emit h2d_d2h_gating_torch_baselines.json as a workload artifact."
  owner: "raiden-dev"
  # Runs like the h2d_d2h_gating_torch workload in benchmark_registry.pbtxt.
  workload {
    action: "./ml_actions/actions/workload_executors/python"
    action_inputs { key: "python_version" value: "3.12" }
    action_inputs { key: "script_path" value: "ci/run_in_tpu_env.py" }
    action_inputs { key: "project_path" value: "ci" }
    action_inputs { key: "runtime_flags" value: "tpu_sync/benchmarks/h2d_d2h_benchmark_gating.py --record --iters=500 --framework=torch" }
  }
  environment_configs {
    id: "tpu-v5e-single-node"
    runner_label: "linux-x86-ct5lp-224-8tpu"
    container_image: "us-central1-docker.pkg.dev/tpu-prod-env-multipod/tpu-raiden/ml-build:gcc12-headers-ibverbs"
  }
}
