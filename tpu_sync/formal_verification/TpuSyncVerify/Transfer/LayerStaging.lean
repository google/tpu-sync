namespace TpuSyncVerify.Transfer

/-- `ResolveEnvNumStagingLayers` (`base.cc`). -/
def resolveEnvNumStagingLayers (numLayers : Nat) (envRequested : Option Nat) : Nat :=
  match envRequested with
  | none => numLayers
  | some requested => if requested = 0 ∨ numLayers ≤ requested then numLayers else requested

theorem resolveEnvNumStagingLayers_bounds (numLayers : Nat) (req : Option Nat) :
    resolveEnvNumStagingLayers numLayers req ≤ numLayers ∧
      (0 < numLayers → 0 < resolveEnvNumStagingLayers numLayers req) := by
  cases req with
  | none => simp [resolveEnvNumStagingLayers]
  | some _ => simp only [resolveEnvNumStagingLayers]; split <;> omega

/-- `CheckAllLayersHaveHostBuffers` (`base.cc`). -/
def checkAllLayersHaveHostBuffers (targetLayer : Option Nat) (numHostLayers numLayers : Nat) : Bool :=
  !(targetLayer.isNone && decide (numHostLayers < numLayers))

/-- Per-session host layer slot manager `tpu_raiden::StagingLayerManager` (`staging.h`). -/
structure StagingLayerManager where
  numSlots : Nat
  free : List Nat
  leases : List (Nat × Nat) := []
  shutdown : Bool := false
  deriving Repr, DecidableEq, Hashable

namespace StagingLayerManager

def init (numSlots : Nat) : StagingLayerManager :=
  { numSlots := numSlots, free := List.range numSlots, leases := [], shutdown := false }

def lookup (m : StagingLayerManager) (unit : Nat) : Option Nat :=
  (m.leases.find? (fun p => p.1 == unit)).map Prod.snd

def numFree (m : StagingLayerManager) : Nat := m.free.length

def ready (m : StagingLayerManager) (unit : Nat) (cancelled : Bool) : Bool :=
  m.shutdown || cancelled || (m.lookup unit).isSome || !m.free.isEmpty

inductive AcquireOutcome where
  | noSlots | timedOut | cancelled | leased (slot : Nat) (m' : StagingLayerManager)
  deriving Repr, DecidableEq

/-- `StagingLayerManager::Acquire(unit, deadline, cancelled)`. Returns `none`
while blocked in `AwaitWithDeadline` (`!ready ∧ !timedOut`). -/
def acquire (m : StagingLayerManager) (unit : Nat)
    (cancelled : Bool := false) (timedOut : Bool := false) : Option AcquireOutcome :=
  if m.free.isEmpty && m.leases.isEmpty then some .noSlots
  else if !m.ready unit cancelled then if timedOut then some .timedOut else none
  else if m.shutdown || cancelled then some .cancelled
  else match m.lookup unit with
    | some slot => some (.leased slot m)
    | none => match m.free with
      | [] => none
      | slot :: rest => some (.leased slot { m with free := rest, leases := m.leases ++ [(unit, slot)] })

def release (m : StagingLayerManager) (unit : Nat) : Option Nat × StagingLayerManager :=
  match m.lookup unit with
  | none => (none, m)
  | some slot => (some slot, { m with free := m.free ++ [slot], leases := m.leases.filter (·.1 != unit) })

def releaseAll (m : StagingLayerManager) : StagingLayerManager :=
  { m with free := m.free ++ m.leases.map Prod.snd, leases := [] }

def doShutdown (m : StagingLayerManager) : StagingLayerManager := { m with shutdown := true }

/-! ## Invariant and structural lemmas -/

def allSlots (m : StagingLayerManager) : List Nat := m.free ++ m.leases.map Prod.snd

def decNodup {α : Type} [DecidableEq α] : (l : List α) → Decidable l.Nodup
  | [] => isTrue List.nodup_nil
  | x :: xs => match decNodup xs with
    | isFalse h => isFalse fun hc => h (List.nodup_cons.mp hc).2
    | isTrue h =>
      if hx : x ∈ xs then isFalse fun hc => (List.nodup_cons.mp hc).1 hx
      else isTrue (List.nodup_cons.mpr ⟨hx, h⟩)

instance instDecidableNodup {α : Type} [DecidableEq α] (l : List α) : Decidable l.Nodup := decNodup l
instance instDecidablePairwiseNe {α : Type} [DecidableEq α] (l : List α) :
    Decidable (List.Pairwise (· ≠ ·) l) := decNodup l

structure Inv (m : StagingLayerManager) : Prop where
  conservation : m.free.length + m.leases.length = m.numSlots
  nodupSlots : m.allSlots.Nodup
  nodupUnits : (m.leases.map Prod.fst).Nodup
  slotsBound : ∀ s ∈ m.allSlots, s < m.numSlots

theorem inv_init (numSlots : Nat) : Inv (init numSlots) :=
  ⟨by simp [init], by simp [init, allSlots, List.nodup_range], by simp [init],
   fun _ hs => by simpa [init, allSlots] using hs⟩

theorem lookup_eq_some_mem {m : StagingLayerManager} {u s : Nat} (h : m.lookup u = some s) :
    (u, s) ∈ m.leases := by
  unfold lookup at h
  cases hf : m.leases.find? (fun p => p.1 == u) with
  | none => simp [hf] at h
  | some p =>
    rcases p with ⟨u', s'⟩; have hp1 : u' = u := by simpa using List.find?_some hf
    simp only [hf, Option.map_some, Option.some.injEq] at h
    subst h hp1; exact List.mem_of_find?_eq_some hf

theorem lookup_none_iff {m : StagingLayerManager} {u : Nat} :
    m.lookup u = none ↔ u ∉ m.leases.map Prod.fst := by
  unfold lookup; constructor
  · intro h hmem; rcases List.mem_map.mp hmem with ⟨⟨u', s⟩, hp, rfl⟩
    cases hf : m.leases.find? (fun p => p.1 == u') with
    | none => simpa using (List.find?_eq_none.mp hf) (u', s) hp
    | some _ => simp [hf] at h
  · intro hnot; cases hf : m.leases.find? (fun p => p.1 == u) with
    | none => rfl
    | some p =>
      have hp1 : p.1 = u := by simpa using List.find?_some hf
      exact absurd (hp1 ▸ List.mem_map_of_mem (f := Prod.fst) (List.mem_of_find?_eq_some hf)) hnot

private theorem eq_of_mem_of_nodup_map {α β : Type} {f : α → β} {xs : List α}
    (hnd : (xs.map f).Nodup) {x y : α} (hx : x ∈ xs) (hy : y ∈ xs) (heq : f x = f y) : x = y := by
  induction xs with
  | nil => cases hx
  | cons a rest ih =>
    rcases List.nodup_cons.mp hnd with ⟨hnot, hrest⟩
    rcases List.mem_cons.mp hx with rfl | hx' <;> rcases List.mem_cons.mp hy with rfl | hy'
    · rfl
    · exact absurd (heq ▸ List.mem_map_of_mem hy') hnot
    · exact absurd (heq.symm ▸ List.mem_map_of_mem hx') hnot
    · exact ih hrest hx' hy'

theorem lookup_eq_some_of_mem {m : StagingLayerManager}
    (hnodup : (m.leases.map Prod.fst).Nodup) {u s : Nat} (hmem : (u, s) ∈ m.leases) :
    m.lookup u = some s := by
  cases hl : m.lookup u with
  | none => exact absurd (List.mem_map_of_mem (f := Prod.fst) hmem) (lookup_none_iff.mp hl)
  | some _ =>
    exact congrArg some (Prod.mk.inj (eq_of_mem_of_nodup_map hnodup (lookup_eq_some_mem hl) hmem rfl)).2

theorem lookup_lt {m : StagingLayerManager} (hinv : Inv m) {u s : Nat}
    (hl : m.lookup u = some s) : s < m.numSlots :=
  hinv.slotsBound s (List.mem_append_right _ (List.mem_map_of_mem (lookup_eq_some_mem hl)))

theorem lookup_not_mem_free {m : StagingLayerManager} (hinv : Inv m) {u s : Nat}
    (hl : m.lookup u = some s) : s ∉ m.free :=
  fun hf => (List.nodup_append.mp hinv.nodupSlots).2.2 s hf s (List.mem_map_of_mem (lookup_eq_some_mem hl)) rfl

theorem lookup_injective {m : StagingLayerManager} (hinv : Inv m) {u₁ u₂ s : Nat}
    (h₁ : m.lookup u₁ = some s) (h₂ : m.lookup u₂ = some s) : u₁ = u₂ :=
  (Prod.mk.inj (eq_of_mem_of_nodup_map (List.nodup_append.mp hinv.nodupSlots).2.1
    (lookup_eq_some_mem h₁) (lookup_eq_some_mem h₂) rfl)).1

theorem acquire_leased_cases {m m' : StagingLayerManager} {u slot : Nat} {c t : Bool}
    (hacq : m.acquire u c t = some (.leased slot m')) :
    m.shutdown = false ∧ c = false ∧
      ((m.lookup u = some slot ∧ m' = m) ∨
       (m.lookup u = none ∧ ∃ rest, m.free = slot :: rest ∧
         m' = { m with free := rest, leases := m.leases ++ [(u, slot)] })) := by
  unfold acquire at hacq
  split at hacq; · cases hacq
  split at hacq; · split at hacq <;> cases hacq
  split at hacq; · cases hacq
  have hsc : m.shutdown = false ∧ c = false := by cases hs : m.shutdown <;> cases hc : c <;> simp_all
  refine ⟨hsc.1, hsc.2, ?_⟩
  cases hl : m.lookup u with
  | some _ =>
    simp only [hl, Option.some.injEq, AcquireOutcome.leased.injEq] at hacq
    rcases hacq with ⟨rfl, rfl⟩; exact Or.inl ⟨rfl, rfl⟩
  | none =>
    simp only [hl] at hacq
    cases hf : m.free with
    | nil => simp [hf] at hacq
    | cons _ rest =>
      simp only [hf, Option.some.injEq, AcquireOutcome.leased.injEq] at hacq
      rcases hacq with ⟨rfl, rfl⟩; exact Or.inr ⟨rfl, rest, rfl, rfl⟩

theorem acquire_inv {m m' : StagingLayerManager} {u slot : Nat} {c t : Bool}
    (hinv : Inv m) (hacq : m.acquire u c t = some (.leased slot m')) : Inv m' := by
  rcases (acquire_leased_cases hacq).2.2 with ⟨_, rfl⟩ | ⟨hl, rest, hf, rfl⟩
  · exact hinv
  · have hcons := hinv.conservation; have hnd := hinv.nodupSlots
    refine ⟨by simp [hf] at hcons ⊢; omega, ?_, ?_, ?_⟩
    · unfold allSlots at hnd ⊢
      simp only [hf, List.cons_append, List.map_append, List.map_singleton] at hnd ⊢
      rcases List.nodup_cons.mp hnd with ⟨hnot, hrest⟩
      rw [← List.append_assoc, List.nodup_append]
      exact ⟨hrest, by simp, fun a ha b hb hab => by simp at hb; subst hb hab; exact hnot ha⟩
    · simp only [List.map_append, List.map_singleton, List.nodup_append]
      exact ⟨hinv.nodupUnits, by simp, fun a ha b hb hab => by
        simp at hb; subst hb hab; exact lookup_none_iff.mp hl ha⟩
    · intro s hs; apply hinv.slotsBound
      unfold allSlots at hs ⊢
      simp only [hf, List.map_append, List.map_singleton, List.cons_append,
                 List.mem_cons, List.mem_append, List.not_mem_nil, or_false] at hs ⊢
      rcases hs with hs | hs | rfl
      · exact Or.inr (Or.inl hs)
      · exact Or.inr (Or.inr hs)
      · exact Or.inl rfl

theorem acquire_leased_lookup {m m' : StagingLayerManager} {u slot : Nat} {c t : Bool}
    (hinv : Inv m) (hacq : m.acquire u c t = some (.leased slot m')) :
    m'.lookup u = some slot ∧ slot < m.numSlots ∧ m'.numSlots = m.numSlots ∧
      m'.shutdown = m.shutdown ∧ (∀ u', u' ≠ u → m'.lookup u' = m.lookup u') := by
  have hinv' := acquire_inv hinv hacq
  rcases (acquire_leased_cases hacq).2.2 with ⟨hl, rfl⟩ | ⟨_, rest, hf, hm'⟩
  · exact ⟨hl, lookup_lt hinv hl, rfl, rfl, fun _ _ => rfl⟩
  · refine ⟨lookup_eq_some_of_mem hinv'.nodupUnits (by simp [hm']),
      hinv.slotsBound slot (by simp [allSlots, hf]), by simp [hm'], by simp [hm'], fun u' hne => ?_⟩
    cases hl' : m.lookup u' with
    | none =>
      rw [lookup_none_iff] at hl' ⊢
      simp only [hm', List.map_append, List.map_singleton, List.mem_append, List.mem_singleton]
      rintro (h | rfl); exact hl' h; exact hne rfl
    | some _ => exact lookup_eq_some_of_mem hinv'.nodupUnits (by simp [hm', lookup_eq_some_mem hl'])

theorem acquire_idempotent {m : StagingLayerManager} {u slot : Nat} {c t : Bool}
    (hl : m.lookup u = some slot) (hsh : m.shutdown = false) (hc : c = false) :
    m.acquire u c t = some (.leased slot m) := by
  have hmem := lookup_eq_some_mem hl
  have hne : m.leases.isEmpty = false := by cases hls : m.leases <;> simp_all
  unfold acquire ready; simp [hl, hsh, hc, hne]

theorem shutdown_cancels {m : StagingLayerManager} (hinv : Inv m)
    (hsh : m.shutdown = true) (hpos : 0 < m.numSlots) (u : Nat) (c t : Bool) :
    m.acquire u c t = some .cancelled := by
  have hne : (m.free.isEmpty && m.leases.isEmpty) = false := by
    have := hinv.conservation; cases hf : m.free <;> cases hl : m.leases <;> simp_all
  unfold acquire ready; simp [hne, hsh]

theorem no_slots_acquire {m : StagingLayerManager} (hinv : Inv m)
    (hz : m.numSlots = 0) (u : Nat) (c t : Bool) : m.acquire u c t = some .noSlots := by
  have := hinv.conservation
  simp [acquire, List.eq_nil_of_length_eq_zero (l := m.free) (by omega),
        List.eq_nil_of_length_eq_zero (l := m.leases) (by omega)]

theorem release_noop_of_none {m : StagingLayerManager} {u : Nat}
    (hl : m.lookup u = none) : m.release u = (none, m) := by simp [release, hl]

private theorem filter_ne_length {leases : List (Nat × Nat)} {u s : Nat}
    (hnd : (leases.map Prod.fst).Nodup) (hmem : (u, s) ∈ leases) :
    (leases.filter (·.1 != u)).length + 1 = leases.length := by
  induction leases with
  | nil => cases hmem
  | cons p rest ih =>
    rcases p with ⟨u', s'⟩; rcases List.nodup_cons.mp hnd with ⟨hnot, hrest⟩
    rcases List.mem_cons.mp hmem with h_eq | hmem'
    · rcases Prod.mk.inj h_eq with ⟨rfl, rfl⟩
      rw [List.filter_cons_of_neg (by simp), List.filter_eq_self.mpr]; · rfl
      rintro ⟨a, _⟩ hp; exact bne_iff_ne.mpr fun h =>
        hnot (h ▸ (List.mem_map_of_mem (f := Prod.fst) hp : a ∈ rest.map Prod.fst))
    · have hne : (u' != u) = true := bne_iff_ne.mpr fun h => by
        subst h; exact hnot (List.mem_map_of_mem (f := Prod.fst) hmem' : u' ∈ rest.map Prod.fst)
      have := ih hrest hmem'; simp [hne]; omega

theorem release_inv (m : StagingLayerManager) (u : Nat) (hinv : Inv m) : Inv (m.release u).2 := by
  unfold release
  cases hl : m.lookup u with
  | none => exact hinv
  | some s =>
    have hmem := lookup_eq_some_mem hl; have hcons := hinv.conservation
    have hlen := filter_ne_length hinv.nodupUnits hmem
    rcases List.nodup_append.mp hinv.nodupSlots with ⟨hfree, hls, hd⟩
    have hsub := List.filter_sublist (l := m.leases) (p := (·.1 != u))
    refine ⟨by simp; omega, ?_, hinv.nodupUnits.sublist (hsub.map Prod.fst), ?_⟩
    · unfold allSlots; simp only
      refine List.nodup_append.mpr ⟨List.nodup_append.mpr ⟨hfree, by simp, fun a ha b hb hab => by
        simp at hb; subst hb hab; exact lookup_not_mem_free hinv hl ha⟩, hls.sublist (hsub.map Prod.snd), ?_⟩
      intro a ha b hb hab; subst hab
      rcases List.mem_map.mp hb with ⟨⟨u', s'⟩, hflt, rfl⟩
      rcases List.mem_filter.mp hflt with ⟨hm', hne_b⟩
      rcases List.mem_append.mp ha with hmf | hms
      · exact hd s' hmf s' (List.mem_map_of_mem hm') rfl
      · simp at hms; subst hms
        exact (bne_iff_ne.mp hne_b) (Prod.mk.inj (eq_of_mem_of_nodup_map hls hm' hmem rfl)).1
    · intro x hx; unfold allSlots at hx; simp only [List.mem_append, List.mem_singleton] at hx
      rcases hx with (hx | rfl) | hx
      · exact hinv.slotsBound x (List.mem_append_left _ hx)
      · exact lookup_lt hinv hl
      · exact hinv.slotsBound x (List.mem_append_right _ ((hsub.map Prod.snd).subset hx))

theorem release_lookup (m : StagingLayerManager) (u : Nat) (hinv : Inv m) :
    (m.release u).2.lookup u = none ∧ (m.release u).2.numSlots = m.numSlots ∧
      (m.release u).2.shutdown = m.shutdown ∧
      (∀ u', u' ≠ u → (m.release u).2.lookup u' = m.lookup u') := by
  unfold release
  cases hl : m.lookup u with
  | none => simp [hl]
  | some _ =>
    have hsub := (List.filter_sublist (l := m.leases) (p := (·.1 != u))).map Prod.fst
    refine ⟨lookup_none_iff.mpr (by simp [List.mem_filter]), rfl, rfl, fun u' hne => ?_⟩
    cases hl' : m.lookup u' with
    | none => exact lookup_none_iff.mpr fun hm => (lookup_none_iff.mp hl') (hsub.subset hm)
    | some _ =>
      exact lookup_eq_some_of_mem (hinv.nodupUnits.sublist hsub)
        (List.mem_filter.mpr ⟨lookup_eq_some_mem hl', bne_iff_ne.mpr hne⟩)

theorem releaseAll_inv (m : StagingLayerManager) (hinv : Inv m) : Inv m.releaseAll := by
  have hall : m.releaseAll.allSlots = m.allSlots := by simp [releaseAll, allSlots]
  exact ⟨by simp [releaseAll, hinv.conservation], hall ▸ hinv.nodupSlots,
    by simp [releaseAll], fun s hs => hinv.slotsBound s (hall ▸ hs)⟩

theorem releaseAll_leases_empty (m : StagingLayerManager) : m.releaseAll.leases = [] := rfl
theorem releaseAll_lookup_none (m : StagingLayerManager) (u : Nat) : m.releaseAll.lookup u = none := rfl
theorem releaseAll_numFree {m : StagingLayerManager} (hinv : Inv m) :
    m.releaseAll.numFree = m.numSlots := by simp [releaseAll, numFree, hinv.conservation]

theorem doShutdown_inv (m : StagingLayerManager) (hinv : Inv m) : Inv m.doShutdown :=
  ⟨hinv.conservation, hinv.nodupSlots, hinv.nodupUnits, hinv.slotsBound⟩

theorem doShutdown_lookup (m : StagingLayerManager) (u : Nat) :
    m.doShutdown.lookup u = m.lookup u := rfl

theorem doShutdown_release (m : StagingLayerManager) (l : Nat) :
    (m.doShutdown.release l).2 = (m.release l).2.doShutdown := by
  unfold release doShutdown lookup; dsimp only; cases m.leases.find? (·.1 == l) <;> rfl

/-- Synchronize `Shutdown()` (when `draining` flips `false → true`) and
`ReleaseAll()` (when `done` flips `false → true`) with a `Lifecycle` transition. -/
def sync (oldLife newLife : Lifecycle) (m : StagingLayerManager) : StagingLayerManager :=
  let m := if !oldLife.draining && newLife.draining then m.doShutdown else m
  if !oldLife.done && newLife.done then m.releaseAll else m

/-- Release `l`'s slot and synchronize `Shutdown()` / `ReleaseAll()` with a
`Lifecycle` transition. -/
def releaseSync (oldLife newLife : Lifecycle) (l : Nat) (m : StagingLayerManager) :
    StagingLayerManager :=
  sync oldLife newLife (m.release l).2

@[simp] theorem sync_self (lf : Lifecycle) (m : StagingLayerManager) : sync lf lf m = m := by
  unfold sync; simp

@[simp] theorem releaseSync_self (lf : Lifecycle) (l : Nat) (m : StagingLayerManager) :
    releaseSync lf lf l m = (m.release l).2 := by unfold releaseSync; simp

theorem sync_of_active {oldLife newLife : Lifecycle} (m : StagingLayerManager)
    (hdr : newLife.draining = false) (hd : newLife.done = false) :
    sync oldLife newLife m = m := by unfold sync; simp [hdr, hd]

theorem acquire_leased_numSlots {m m' : StagingLayerManager} {u slot : Nat} {c t : Bool}
    (hacq : m.acquire u c t = some (.leased slot m')) : m'.numSlots = m.numSlots := by
  rcases (acquire_leased_cases hacq).2.2 with ⟨_, rfl⟩ | ⟨_, _, _, rfl⟩ <;> rfl

@[simp] theorem release_numSlots (m : StagingLayerManager) (u : Nat) :
    (m.release u).2.numSlots = m.numSlots := by unfold release; split <;> rfl

@[simp] theorem sync_numSlots (oldLife newLife : Lifecycle) (m : StagingLayerManager) :
    (sync oldLife newLife m).numSlots = m.numSlots := by unfold sync; split <;> split <;> rfl

@[simp] theorem releaseSync_numSlots (oldLife newLife : Lifecycle) (l : Nat) (m : StagingLayerManager) :
    (releaseSync oldLife newLife l m).numSlots = m.numSlots := by
  unfold releaseSync; simp

theorem sync_inv (oldLife newLife : Lifecycle) {m : StagingLayerManager}
    (hinv : m.Inv) : (sync oldLife newLife m).Inv := by
  unfold sync; dsimp only; split <;> split
  · exact releaseAll_inv _ (m.doShutdown_inv hinv)
  · exact releaseAll_inv _ hinv
  · exact m.doShutdown_inv hinv
  · exact hinv

theorem releaseSync_inv (oldLife newLife : Lifecycle) (l : Nat) {m : StagingLayerManager}
    (hinv : m.Inv) : (releaseSync oldLife newLife l m).Inv :=
  sync_inv oldLife newLife (m.release_inv l hinv)

theorem sync_shutdown {oldLife newLife : Lifecycle} {m : StagingLayerManager}
    (hdr : oldLife.draining = true → m.shutdown = true) (hnew : newLife.draining = true) :
    (sync oldLife newLife m).shutdown = true := by
  unfold sync
  cases hod : oldLife.draining with
  | false => simp only [hnew, Bool.not_false, Bool.true_and, ↓reduceIte]; split <;> rfl
  | true =>
    simp only [Bool.not_true, Bool.false_and, Bool.false_eq_true, ↓reduceIte]; split <;> exact hdr hod

theorem sync_done_leases {oldLife newLife : Lifecycle} {m : StagingLayerManager}
    (hd : oldLife.done = true → m.leases = []) (hnew : newLife.done = true) :
    (sync oldLife newLife m).leases = [] := by
  unfold sync
  cases hod : oldLife.done with
  | false => simp [hnew, releaseAll]
  | true =>
    simp only [Bool.not_true, Bool.false_and, Bool.false_eq_true, ↓reduceIte]; split <;> exact hd hod

theorem sync_lookup_of_not_done {oldLife newLife : Lifecycle} (m : StagingLayerManager)
    (hnd : newLife.done = false) (u : Nat) :
    (sync oldLife newLife m).lookup u = m.lookup u := by
  unfold sync; simp only [hnd, Bool.and_false, Bool.false_eq_true, ↓reduceIte]
  split; exact m.doShutdown_lookup u; rfl

theorem releaseSync_lookup_of_not_done {oldLife newLife : Lifecycle} (l : Nat)
    (m : StagingLayerManager) (hnd : newLife.done = false) (u : Nat) :
    (releaseSync oldLife newLife l m).lookup u = (m.release l).2.lookup u :=
  sync_lookup_of_not_done (m.release l).2 hnd u

end StagingLayerManager

/-- Generic coupling invariant between a session's `Lifecycle`, its
`StagingLayerManager`, its physical buffer array `slots`, and its logical
unit-ownership predicate `owns`. -/
structure SlotPoolInv {α : Type} (life : Lifecycle) (mgr : StagingLayerManager)
    (slots : List α) (owns : Nat → Prop) : Prop where
  mgrInv : mgr.Inv
  lenSlots : slots.length = mgr.numSlots
  drainingShutdown : life.draining = true → mgr.shutdown = true
  doneLeases : life.done = true → mgr.leases = []
  leasesIff : life.done = false → ∀ u : Nat, (mgr.lookup u).isSome = true ↔ owns u

namespace SlotPoolInv

theorem init {α : Type} {life : Lifecycle} (k : Nat) (v : α) {owns : Nat → Prop}
    (hdr : life.draining = false) (hd : life.done = false) (ho : ∀ u, ¬ owns u) :
    SlotPoolInv life (StagingLayerManager.init k) (List.replicate k v) owns :=
  ⟨StagingLayerManager.inv_init k, by simp [StagingLayerManager.init],
   fun h => by simp [hdr] at h, fun h => by simp [hd] at h,
   fun _ u => by simp [StagingLayerManager.init, StagingLayerManager.lookup, ho u]⟩

theorem lookup_of_owns {α : Type} {life : Lifecycle} {mgr : StagingLayerManager}
    {slots : List α} {owns : Nat → Prop} {u : Nat}
    (h : SlotPoolInv life mgr slots owns) (hnd : life.done = false) (ho : owns u) :
    ∃ slot, mgr.lookup u = some slot ∧ slot < slots.length := by
  have his := (h.leasesIff hnd u).mpr ho
  cases hlk : mgr.lookup u with
  | none => simp [hlk] at his
  | some slot => exact ⟨slot, rfl, h.lenSlots ▸ StagingLayerManager.lookup_lt h.mgrInv hlk⟩

theorem frame {α : Type} {life life' : Lifecycle} {mgr mgr' : StagingLayerManager}
    {slots slots' : List α} {owns owns' : Nat → Prop}
    (h : SlotPoolInv life mgr slots owns)
    (hLife : life' = life) (hMgr : mgr' = mgr) (hSlots : slots' = slots)
    (hOwns : ∀ u, owns' u ↔ owns u) :
    SlotPoolInv life' mgr' slots' owns' :=
  ⟨hMgr ▸ h.mgrInv, by rw [hSlots, hMgr]; exact h.lenSlots,
   by rw [hLife, hMgr]; exact h.drainingShutdown,
   by rw [hLife, hMgr]; exact h.doneLeases,
   fun hnd u => by rw [hMgr, hOwns u]; exact h.leasesIff (hLife ▸ hnd) u⟩

theorem sync {α : Type} {life life' : Lifecycle} {mgr mgr' : StagingLayerManager}
    {slots slots' : List α} {owns owns' : Nat → Prop}
    (h : SlotPoolInv life mgr slots owns)
    (hMgr : mgr' = StagingLayerManager.sync life life' mgr)
    (hSlots : slots' = slots)
    (hOldNotDone : life'.done = false → life.done = false)
    (hOwns : life'.done = false → ∀ u, owns' u ↔ owns u) :
    SlotPoolInv life' mgr' slots' owns' :=
  ⟨hMgr ▸ StagingLayerManager.sync_inv life life' h.mgrInv,
   by rw [hSlots, hMgr, StagingLayerManager.sync_numSlots]; exact h.lenSlots,
   fun hdr => hMgr ▸ StagingLayerManager.sync_shutdown h.drainingShutdown hdr,
   fun hd => hMgr ▸ StagingLayerManager.sync_done_leases h.doneLeases hd,
   fun hnd u => by
     rw [hMgr, StagingLayerManager.sync_lookup_of_not_done mgr hnd u, hOwns hnd u]
     exact h.leasesIff (hOldNotDone hnd) u⟩

theorem activeOp {α : Type} {life life' : Lifecycle} {mgr : StagingLayerManager}
    {slots : List α} {owns owns' : Nat → Prop}
    (h : SlotPoolInv life mgr slots owns)
    (hdr' : life'.draining = false) (hd' : life'.done = false) (hd : life.done = false)
    (hOwns : ∀ u, owns' u ↔ owns u) :
    SlotPoolInv life' mgr slots owns' :=
  h.sync (StagingLayerManager.sync_of_active mgr hdr' hd').symm rfl (fun _ => hd) (fun _ => hOwns)

theorem releaseSync {α : Type} {life life' : Lifecycle} {mgr mgr' : StagingLayerManager}
    {slots slots' : List α} {owns owns' : Nat → Prop} {l : Nat}
    (h : SlotPoolInv life mgr slots owns)
    (hMgr : mgr' = StagingLayerManager.releaseSync life life' l mgr)
    (hSlots : slots' = slots)
    (hOldNotDone : life'.done = false → life.done = false)
    (hNotL : life'.done = false → ¬ owns' l)
    (hOther : life'.done = false → ∀ u, u ≠ l → (owns' u ↔ owns u)) :
    SlotPoolInv life' mgr' slots' owns' := by
  obtain ⟨hrel_l, hrel_num, hrel_sh, hrel_ne⟩ := mgr.release_lookup l h.mgrInv
  have hrel_nil : life.done = true → (mgr.release l).2.leases = [] := fun hd => by
    rw [mgr.release_noop_of_none (by simp [StagingLayerManager.lookup, h.doneLeases hd])]
    exact h.doneLeases hd
  refine ⟨hMgr ▸ StagingLayerManager.releaseSync_inv life life' l h.mgrInv,
    by rw [hSlots, hMgr, StagingLayerManager.releaseSync_numSlots]; exact h.lenSlots,
    fun hdr => hMgr ▸ StagingLayerManager.sync_shutdown (fun hod => hrel_sh.trans (h.drainingShutdown hod)) hdr,
    fun hd => hMgr ▸ StagingLayerManager.sync_done_leases hrel_nil hd,
    fun hnd u => ?_⟩
  rw [hMgr, StagingLayerManager.releaseSync, StagingLayerManager.sync_lookup_of_not_done _ hnd u]
  by_cases hu : u = l
  · subst hu; simp [hrel_l, hNotL hnd]
  · rw [hrel_ne u hu, hOther hnd u hu]; exact h.leasesIff (hOldNotDone hnd) u

theorem acquire {α : Type} {life life' : Lifecycle} {mgr mgr' : StagingLayerManager}
    {slots : List α} {owns owns' : Nat → Prop} {l slot : Nat} {c t : Bool}
    (h : SlotPoolInv life mgr slots owns)
    (hacq : mgr.acquire l c t = some (.leased slot mgr'))
    (hdr' : life'.draining = false) (hd' : life'.done = false) (hd : life.done = false)
    (hOwnL : owns' l) (hOther : ∀ u, u ≠ l → (owns' u ↔ owns u)) :
    SlotPoolInv life' mgr' slots owns' := by
  obtain ⟨hlk_l, _, hnum', _, hlk_ne⟩ := mgr.acquire_leased_lookup h.mgrInv hacq
  refine ⟨mgr.acquire_inv h.mgrInv hacq, by rw [hnum']; exact h.lenSlots,
    fun hdr => by simp [hdr'] at hdr, fun hd1 => by simp [hd'] at hd1,
    fun _ u => ?_⟩
  by_cases hu : u = l
  · subst hu; simp [hlk_l, hOwnL]
  · rw [hlk_ne u hu, hOther u hu]; exact h.leasesIff hd u

theorem setSlot {α : Type} {life : Lifecycle} {mgr : StagingLayerManager}
    {slots : List α} {owns owns' : Nat → Prop} {slot : Nat} (v : α)
    (h : SlotPoolInv life mgr slots owns)
    (hOwns : life.done = false → ∀ u, owns' u ↔ owns u) :
    SlotPoolInv life mgr (slots.set slot v) owns' :=
  ⟨h.mgrInv, (List.length_set ..).trans h.lenSlots, h.drainingShutdown, h.doneLeases,
   fun hnd u => (h.leasesIff hnd u).trans (hOwns hnd u).symm⟩

theorem reseat {α : Type} {life : Lifecycle} {mgr : StagingLayerManager}
    {slots : List α} {owns owns' : Nat → Prop} (v : α)
    (h : SlotPoolInv life mgr slots owns) (hd : life.done = true) :
    SlotPoolInv life mgr (List.replicate mgr.numSlots v) owns' :=
  ⟨h.mgrInv, List.length_replicate, h.drainingShutdown, h.doneLeases,
   fun hnd => by simp [hd] at hnd⟩

end SlotPoolInv

end TpuSyncVerify.Transfer
