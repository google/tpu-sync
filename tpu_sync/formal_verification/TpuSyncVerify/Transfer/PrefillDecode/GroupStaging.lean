namespace TpuSyncVerify.Transfer.PrefillDecode.GroupStaging

open TpuSyncVerify

/-- One layer of a send that moves in `numUnits` block groups under bounded
host layer staging: the units share the layer's host layer buffer. -/
structure S where
  numUnits : Nat
  /-- `draining_` of the send (sticky). -/
  draining : Bool := false
  /-- The layer holds its lease (`StagingLayerManager::leases_` has the layer). -/
  held : Bool := false
  /-- Units whose D2H copy wrote the buffer (ghost). -/
  staged : Nat := 0
  /-- Unit pushes in flight, reading the buffer (ghost). -/
  pushing : Nat := 0
  /-- Units pushed OK: `numUnits - unpushed_units_[layer]`. -/
  pushedOk : Nat := 0
  /-- Staged units whose push failed or that were dropped (ghost). -/
  gone : Nat := 0
  /-- Another layer's copy wrote the buffer while a unit of this layer still
  needed what it holds (ghost). -/
  clobbered : Bool := false
  deriving Repr, DecidableEq, Hashable

inductive Ev where
  | d2h
  | push
  | pushDone (ok : Bool)
  | drop
  | cancel
  | reuse
  deriving Repr, DecidableEq

namespace S

def init (n : Nat) : S := { numUnits := n }

/-- Staged units still waiting for their push (ghost). -/
def waiting (s : S) : Nat := s.staged - s.pushing - s.pushedOk - s.gone

/-- The D2H loop's iteration for the layer's next unit: `AcquireStagingSlot`
(leasing the buffer for the first unit, returning the same lease for the
others; refused once the send is draining), the `if (draining_)` check, then
the copy into the buffer. -/
def d2h (s : S) : Option S :=
  if s.staged < s.numUnits ∧ s.draining = false then
    some { s with held := true, staged := s.staged + 1 }
  else none

/-- A staged unit's push is issued (`IssuePush`). -/
def push (s : S) : Option S :=
  if 0 < s.waiting ∧ s.draining = false then some { s with pushing := s.pushing + 1 } else none

/-- The push callback: an OK push that leaves no unit of the layer unpushed
releases the buffer (`release_layer = --unpushed_units_[layer] == 0`); a
failed push fails the send and releases it. -/
def pushDone (ok : Bool) (s : S) : Option S :=
  if 0 < s.pushing then
    let s := { s with pushing := s.pushing - 1 }
    if ok then
      let s := { s with pushedOk := s.pushedOk + 1 }
      some (if s.pushedOk = s.numUnits then { s with held := false } else s)
    else some { s with gone := s.gone + 1, draining := true, held := false }
  else none

/-- A staged unit is dropped because the send is draining (`SendNextUnit`'s
callback, `AdmitPush` or `IssuePush` finding `draining_`), releasing the
buffer. -/
def drop (s : S) : Option S :=
  if 0 < s.waiting ∧ s.draining = true then
    some { s with gone := s.gone + 1, held := false }
  else none

/-- `Finish(error)`. -/
def cancel (s : S) : Option S := some { s with draining := true }

/-- Another layer leases the buffer and copies into it: possible only once the
buffer is free and while the send is not draining (A1). -/
def reuse (s : S) : Option S :=
  if s.held = false ∧ s.draining = false then
    some { s with clobbered := s.clobbered || decide (0 < s.pushing + s.waiting) }
  else none

def step (s : S) : Ev → Option S
  | .d2h => s.d2h
  | .push => s.push
  | .pushDone ok => s.pushDone ok
  | .drop => s.drop
  | .cancel => s.cancel
  | .reuse => s.reuse

def sys (n : Nat) : System S Ev := ⟨init n, step⟩

/-! ## Properties -/

/-- **The layer keeps its buffer until its last push.** No other layer's copy
writes the buffer while a unit of this layer is waiting for its push or being
pushed from it. -/
def Safe (s : S) : Prop := s.clobbered = false

instance (s : S) : Decidable (Safe s) := by unfold Safe; infer_instance

def violates (s : S) : Bool := !decide (Safe s)

/-! ## Inductive invariant -/

structure Inv (s : S) : Prop where
  units : s.pushing + s.pushedOk + s.gone ≤ s.staged ∧ s.staged ≤ s.numUnits
  /-- On a send that is not draining, a free buffer holds nothing still needed:
  either no unit was staged, or every unit was pushed OK. -/
  free_idle : s.held = false → s.draining = false →
    s.staged = 0 ∨ s.pushedOk = s.numUnits
  /-- Nothing is lost while the send is not draining. -/
  none_gone : s.draining = false → s.gone = 0
  clean : s.clobbered = false

theorem inv_init (n : Nat) : Inv (init n) := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> simp [init]

theorem step_inv {s s' : S} {e : Ev} (h : Inv s) (hs : s.step e = some s') : Inv s' := by
  obtain ⟨⟨hu1, hu2⟩, hfree, hgone, hclean⟩ := h
  cases e with
  | d2h =>
    simp only [step, d2h] at hs
    split at hs
    · cases hs
      exact ⟨⟨by dsimp only; omega, by dsimp only; omega⟩, by simp, hgone, hclean⟩
    · cases hs
  | push =>
    simp only [step, push] at hs
    split at hs
    · cases hs
      rename_i hg
      simp only [waiting] at hg
      exact ⟨⟨by dsimp only; omega, hu2⟩, hfree, hgone, hclean⟩
    · cases hs
  | pushDone ok =>
    simp only [step, pushDone] at hs
    split at hs
    · split at hs
      · split at hs
        · cases hs
          rename_i hlast
          exact ⟨⟨by dsimp only; omega, hu2⟩, fun _ _ => Or.inr hlast, hgone, hclean⟩
        · cases hs
          rename_i hlast
          refine ⟨⟨by dsimp only; omega, hu2⟩, ?_, hgone, hclean⟩
          intro hh hd
          rcases hfree hh hd with h0 | h0
          · left; dsimp only; omega
          · dsimp only at hlast ⊢; omega
      · cases hs
        exact ⟨⟨by dsimp only; omega, hu2⟩, by simp, by simp, hclean⟩
    · cases hs
  | drop =>
    simp only [step, drop] at hs
    split at hs
    · cases hs
      rename_i hg
      simp only [waiting] at hg
      exact ⟨⟨by dsimp only; omega, hu2⟩, fun _ hd => by simp_all, fun hd => by simp_all,
        hclean⟩
    · cases hs
  | cancel =>
    simp only [step, cancel] at hs
    cases hs
    exact ⟨⟨hu1, hu2⟩, by simp, by simp, hclean⟩
  | reuse =>
    simp only [step, reuse] at hs
    split at hs
    · cases hs
      rename_i hg
      obtain ⟨hh, hd⟩ := hg
      refine ⟨⟨hu1, hu2⟩, hfree, hgone, ?_⟩
      have := hgone hd
      simp only [hclean, Bool.false_or, waiting]
      rcases hfree hh hd with h0 | h0 <;> exact decide_eq_false (by omega)
    · cases hs

theorem reachable_inv {n : Nat} {s : S} (hr : (sys n).Reachable s) : Inv s :=
  (sys n).reachable_induction (inv_init n) (fun _ _ _ h hs => step_inv h hs) hr

theorem reachable_safe {n : Nat} {s : S} (hr : (sys n).Reachable s) : Safe s :=
  (reachable_inv hr).clean

/-! ## Search and mutant -/

def allEvents : List Ev := [.d2h, .push, .pushDone true, .pushDone false, .drop, .cancel, .reuse]

#guard ModelCheck.check (sys 3) allEvents violates 40 = .safe

/-- Mutant: every OK push releases the buffer, as when each layer moved in one
push: the next layer's copy can overwrite a unit still waiting for its push. -/
def stepReleaseEachPush (s : S) : Ev → Option S
  | .pushDone true =>
    if 0 < s.pushing then
      some { s with pushing := s.pushing - 1, pushedOk := s.pushedOk + 1, held := false }
    else none
  | e => s.step e

#guard match ModelCheck.check ⟨init 2, stepReleaseEachPush⟩ allEvents violates 20 with
  | .counterexample _ => true
  | _ => false

end S

end TpuSyncVerify.Transfer.PrefillDecode.GroupStaging
